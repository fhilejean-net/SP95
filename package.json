{
  "name": "sp95",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SP95 — driving game: free roam, drift and race, realistic vehicle physics in the browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
