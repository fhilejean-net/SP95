# Cash Factory — copier vers .env, remplir localement, ne jamais commité.

# Dashboard
FACTORY_DASHBOARD_PASSWORD=
FACTORY_SESSION_SECRET=
FACTORY_SECURE_COOKIE=0
FACTORY_TRUST_PROXY=0
FACTORY_HOST=0.0.0.0
PORT=4100

# Données et emails
FACTORY_DATA_KEY=
FACTORY_ANALYTICS_SECRET=
