# Identité légale (obligatoire avant publication)
LEGAL_OPERATOR=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_HOST=

# Stripe (mode test puis live ; secret uniquement côté serveur)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email transactionnel et rapports
RESEND_API_KEY=
FACTORY_FROM_EMAIL=
FACTORY_REPORT_EMAIL=

# Telegram (alternative aux rapports email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Générateur d’idées et futur JARVIS (facultatif)
